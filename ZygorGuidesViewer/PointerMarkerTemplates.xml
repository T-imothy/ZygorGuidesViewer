<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ D:\UI.xsd">

	<Button name="ZygorGuidesViewerPointerMinimapMarker" virtual="true" hidden="false" movable="false" enableMouse="true">
		<Size x="20" y="20"/>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture file="Interface\AddOns\ZygorGuidesViewer\Skin\minimaparrow-green-dot">
					<Size x="12" y="12"/>
					<Anchors><Anchor point="CENTER" relativePoint="CENTER" /></Anchors>
				</Texture>
				<Texture hidden="true" file="Interface\AddOns\ZygorGuidesViewer\Skin\minimaparrow-green-edge">
					<Size x="40" y="40"/>
					<Anchors><Anchor point="CENTER" relativePoint="CENTER" /></Anchors>
				</Texture>
			</Layer>
		</Layers>

		<Scripts>
			<OnLoad> 
				local r1, r2 = this:GetRegions()
				this.icon = r1
				this.arrow = r2
				this:RegisterForClicks("LeftButtonUp")
			</OnLoad>
			<OnEnter> ZGV.Pointer.MinimapButton_OnEnter(this) </OnEnter>
			<OnLeave> ZGV.Pointer.MinimapButton_OnLeave(this) </OnLeave>
			<OnUpdate>ZGV.Pointer.MinimapButton_OnUpdate(this,arg1) </OnUpdate>
			<OnClick> ZGV.Pointer.MinimapButton_OnClick(this,arg1) </OnClick>
			<OnEvent> ZGV.Pointer.MinimapButton_OnEvent(this,event,arg1,arg2,arg3,arg4,arg5,arg6,arg7,arg8,arg9) </OnEvent>
		</Scripts>
	</Button>

	<Button name="ZygorGuidesViewerPointerWorldMapMarker" virtual="true" hidden="false" movable="false" enableMouse="true">
		<Size x="25" y="25"/>
		<Layers>
			<Layer level="ARTWORK">
				<Texture file="Interface\AddOns\ZygorGuidesViewer\Skin\minimaparrow-green-dot" >
					<Anchors><Anchor point="CENTER" relativePoint="CENTER" /></Anchors>
					<Size x="25" y="25"/>
				</Texture>
			</Layer>
		</Layers>

		<Scripts>
			<OnLoad>
				local r1, _ = this:GetRegions()
				this.icon = r1
				this:RegisterForClicks("RightButtonUp","LeftButtonUp")
				this:RegisterEvent("PLAYER_ENTERING_WORLD")
				this:RegisterEvent("WORLD_MAP_UPDATE")
				this:RegisterEvent("ZONE_CHANGED_NEW_AREA")
			</OnLoad>
			<OnEnter> ZGV.Pointer.WorldmapButton_OnEnter(this) </OnEnter>
			<OnLeave> ZGV.Pointer.WorldmapButton_OnLeave(this) </OnLeave>
			<OnClick> ZGV.Pointer.MinimapButton_OnClick(this,arg1) </OnClick>
			<OnEvent> ZGV.Pointer.WorldMapButton_OnEvent(this,event,arg1,arg2,arg3,arg4,arg5,arg6,arg7,arg8,arg9) </OnEvent>
		</Scripts>
